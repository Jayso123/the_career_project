# Supabase (Project Settings > API). The anon key is public by design; never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Payments: "mock" until Razorpay is wired up
VITE_PAYMENT_MODE=mock
# Booking/contact notification emails (EmailJS: emailjs.com > Email Services / Templates / Account)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Where notifications go (your inbox)
VITE_OWNER_EMAIL=
